{
    "name": "julianduque.co",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "build": "pnpm run build:css && pnpm run build:js && pnpm run build:eleventy",
        "build:css": "postcss assets/css/site.css -o assets/css/site-build.css",
        "build:eleventy": "eleventy",
        "build:js": "rollup -c scripts/rollup.config.js",
        "dev": "concurrently \"pnpm:dev:*\"",
        "dev:css": "postcss assets/css/site.css -o assets/css/site-build.css --watch",
        "dev:eleventy": "eleventy --serve",
        "dev:js": "rollup -c scripts/rollup.config.js -w",
        "lint": "pnpm run lint:markdown && pnpm run lint:js",
        "lint:js": "eslint \"**/*.js\"",
        "lint:markdown": "markdownlint-cli2 \"./content/**/*.md\"",
        "postinstall": "husky",
        "precommit": "pnpm run prettier && pnpm run lint",
        "prettier": "prettier --write \"**/*.{css,html,js,json,md,njk,yaml,yml}\"",
        "prettier:markdown": "prettier --write \"content/**/*.md\"",
        "prettier:njk": "prettier --write \"**/*.njk\"",
        "prettier:verify": "prettier --list-different \"**/*.{css,html,js,json,md,njk,yaml,yml}\""
    },
    "dependencies": {
        "@11ty/eleventy": "^3.1.6",
        "@11ty/eleventy-plugin-rss": "^3.0.0",
        "@fontsource/ibm-plex-mono": "^5.2.7",
        "autoprefixer": "^10.5.5",
        "cssnano": "^9.0.2",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "html-minifier-terser": "^7.2.0",
        "jsdom": "^30.0.1",
        "markdown-it": "^15.0.1",
        "markdown-it-anchor": "^9.2.1",
        "postcss": "^8.5.28",
        "postcss-cli": "^12.0.0",
        "rollup": "^4.63.1",
        "sharp": "^0.35.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@prettier/plugin-xml": "^3.4.2",
        "@rollup/plugin-terser": "^1.0.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-plugin-inclusive-language": "^2.2.1",
        "husky": "^9.1.7",
        "markdownlint-cli2": "^0.23.2",
        "prettier": "^3.9.6",
        "prettier-plugin-embed": "^0.5.1"
    },
    "volta": {
        "node": "24.20.0",
        "pnpm": "10.12.1"
    },
    "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
