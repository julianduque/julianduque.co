---
eleventyExcludeFromCollections: true
layout: base.njk
title: Content
pagination:
    data: collections.posts
    size: 10
    alias: posts
    reverse: true
meta:
    robots:
        value: noindex
---

<section class="page">
    <header class="page-header">
        <h1 class="display">Content</h1>
        <p class="page-lede">
            Streams, tutorials, and articles. Mostly Node.js, mostly in Spanish.
        </p>
    </header>

    <ul class="post-list">
        {% for post in posts %}
        <li class="post-row">
            <time datetime="{{ post.date | sitemapdate }}">
                {{ post.date | readableDate }}
            </time>
            <div>
                <h2 class="entry-title">
                    <a href="{{ post.url }}">{{ post.data.title }}</a>
                </h2>
                {% if post.data.category %}
                <div class="entry-meta">
                    <span>{{ post.data.category }}</span>
                </div>
                {% endif %}
            </div>
            <span class="post-row-reading">
                {{ post.templateContent | striptags | wordcount | readingTime }}
            </span>
        </li>
        {% endfor %}
    </ul>

    {% if pagination.pages.length > 1 %}
    <nav class="pagination" aria-label="Pagination">
        {% if pagination.href.previous %}
        <a
            href="{{ pagination.href.previous }}"
            class="button button-quiet button-small"
        >
            Previous
        </a>
        {% else %}
        <span class="button button-quiet button-small" aria-disabled="true">
            Previous
        </span>
        {% endif %} {% for href in pagination.hrefs %} {% set isCurrent = href
        == page.url %}
        <a
            href="{{ href }}"
            class="button button-quiet button-small tabular"
            {%
            if
            isCurrent
            %}aria-current="page"
            {%
            endif
            %}
        >
            {{ loop.index }}
        </a>
        {% endfor %} {% if pagination.href.next %}
        <a
            href="{{ pagination.href.next }}"
            class="button button-quiet button-small"
        >
            Next
        </a>
        {% else %}
        <span class="button button-quiet button-small" aria-disabled="true">
            Next
        </span>
        {% endif %}
    </nav>
    {% endif %}
</section>
