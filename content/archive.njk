---
eleventyExcludeFromCollections: true
layout: base.njk
title: Archive
meta:
    robots:
        value: noindex
---

<section class="page">
    <header class="page-header">
        <h1 class="display">Archive</h1>
        <p class="page-lede">Every post, by year.</p>
    </header>

    {% set years = [] %} {% for post in collections.posts %} {% set y = post |
    year %} {% if y not in years %}{% set years = (years.push(y), years) %}{%
    endif %} {% endfor %} {% for y in years | reverse %} {% set yearPosts = []
    %} {% for post in collections.posts | reverse %} {% if (post | year) == y
    %}{% set yearPosts = (yearPosts.push(post), yearPosts) %}{% endif %} {%
    endfor %}
    <h2 class="headline archive-year">
        {{ y }}
        <span class="index-count tabular">{{ yearPosts | length }}</span>
    </h2>
    <ul class="archive-list">
        {% for post in yearPosts %}
        <li class="archive-row">
            <time datetime="{{ post.date | sitemapdate }}">
                {{ post.date | month }} {{ post.date | day }}
            </time>
            <a href="{{ post.url }}">{{ post.data.title }}</a>
        </li>
        {% endfor %}
    </ul>
    {% endfor %}
</section>
