---
layout: base.njk
---

<article class="page post">
    <header class="post-header">
        <h1 class="display">{{ title }}</h1>
        <div class="post-meta">
            <span>
                <time datetime="{{ date | sitemapdate }}">
                    {{ date | readableDate }}
                </time>
            </span>
            <span>{{ content | striptags | wordcount | readingTime }}</span>
            {% if category %}
            <span>{{ category }}</span>
            {% endif %}
        </div>
    </header>
    {% if image %}
    <img class="page-image" src="{{ image }}" alt="{{ imageAlt }}" />
    {% endif %}
    <div class="prose">{{ content | safe }}</div>

    <div class="post-share">
        <span class="label">Share</span>
        <button
            type="button"
            class="button button-quiet button-small"
            data-copy-link
        >
            <svg class="button-icon" viewBox="0 0 14 14" aria-hidden="true">
                <path
                    d="M6 8.5 8.5 6M4.5 9.5l-1 1a2.1 2.1 0 0 1-3-3l2-2a2.1 2.1 0 0 1 3 0M9.5 4.5l1-1a2.1 2.1 0 0 1 3 3l-2 2a2.1 2.1 0 0 1-3 0"
                />
            </svg>
            <span data-copy-label>Copy link</span>
        </button>
        <a
            class="button button-quiet button-small"
            href="https://www.linkedin.com/sharing/share-offsite/?url={{ page.url | absoluteUrl | urlencode }}"
            rel="noopener"
        >
            LinkedIn
        </a>
        <a
            class="button button-quiet button-small"
            href="https://bsky.app/intent/compose?text={{ (title + ' ' + (page.url | absoluteUrl)) | urlencode }}"
            rel="noopener"
        >
            Bluesky
        </a>
        <a
            class="button button-quiet button-small"
            href="https://x.com/intent/post?text={{ title | urlencode }}&url={{ page.url | absoluteUrl | urlencode }}&via={{ siteconfig.socialX }}"
            rel="noopener"
        >
            X
        </a>
    </div>

    {% set previousPost = collections.posts | getPreviousCollectionItem(page) %}
    {% set nextPost = collections.posts | getNextCollectionItem(page) %}
    <nav class="post-nav" aria-label="Post navigation">
        {% if previousPost.url %}
        <a href="{{ previousPost.url }}" class="post-nav-cell">
            <span class="label">Previous</span>
            <span class="post-nav-title">{{ previousPost.data.title }}</span>
        </a>
        {% else %}
        <div class="post-nav-cell" aria-disabled="true">
            <span class="label">Previous</span>
            <span class="post-nav-title">This is the first post</span>
        </div>
        {% endif %} {% if nextPost.url %}
        <a href="{{ nextPost.url }}" class="post-nav-cell">
            <span class="label">Next</span>
            <span class="post-nav-title">{{ nextPost.data.title }}</span>
        </a>
        {% else %}
        <div class="post-nav-cell" aria-disabled="true">
            <span class="label">Next</span>
            <span class="post-nav-title">This is the latest post</span>
        </div>
        {% endif %}
    </nav>
</article>
